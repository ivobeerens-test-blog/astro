---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import FormattedDate from '../../components/FormattedDate.astro';
import { getDescription, getPublishedPosts } from '../../lib/posts';

const posts = await getPublishedPosts();

// Group the posts by year, newest year first
const years = new Map<number, typeof posts>();
for (const post of posts) {
	const year = post.data.pubDate.getFullYear();
	years.set(year, [...(years.get(year) ?? []), post]);
}
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.year-posts {
				margin: 0;
				list-style: none;
			}
			.year-posts li + li {
				margin-top: 1.4rem;
				padding-top: 1.4rem;
				border-top: 1px solid var(--line);
			}
			.year-posts .stack-title {
				font-size: 1.35em;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="page-head">
				<div>
					<h1>All blog posts</h1>
					<p class="lead">Every post on the blog, grouped by year, newest first.</p>
				</div>
				<div class="meta">
					Posts
					<strong>{posts.length}</strong>
				</div>
			</div>

			<div class="stack">
				{
					[...years].map(([year, yearPosts], y) => (
						<section class="stack-row" aria-label={`Posts from ${year}`}>
							<div class="panel-label">
								<span class="big">{year}</span>
								<small>
									{yearPosts.length} {yearPosts.length === 1 ? 'post' : 'posts'}
								</small>
							</div>
							<ul class="stack-body year-posts">
								{yearPosts.map((post, i) => (
									<li>
										<h2 class="stack-title">
											<a href={`/blog/${post.id}/`}>{post.data.title}</a>
										</h2>
										<p class="stack-text">{getDescription(post)}</p>
										<p class="stack-meta">
											<FormattedDate date={post.data.pubDate} />
											{y === 0 && i === 0 && <span class="pill">NEW</span>}
										</p>
									</li>
								))}
							</ul>
						</section>
					))
				}
			</div>
		</main>
		<Footer />
	</body>
</html>
