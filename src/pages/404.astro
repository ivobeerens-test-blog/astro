---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getPublishedPosts } from '../lib/posts';

const recentPosts = (await getPublishedPosts()).slice(0, 5);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Page not found - Ivo Beerens Blog" description="This page doesn't exist. Search the blog or pick one of the latest posts." />
		<meta name="robots" content="noindex" />
		<style>
			.search-form {
				display: flex;
				gap: 0.75rem;
				max-width: 560px;
				margin: 0 0 2.5rem;
			}
			.search-form input {
				flex: 1;
				min-width: 0;
				padding: 0.75rem 1rem;
				border: 1px solid var(--line);
				border-radius: 4px;
				font: inherit;
			}
			.search-form input:focus {
				outline: 2px solid var(--link);
				outline-offset: -1px;
			}
			.more {
				margin-top: 1.5rem;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="page-head">
				<div>
					<h1>Page not found</h1>
					<p class="lead">
						This page doesn't exist (any more). Try searching the blog, or start with one of the
						latest posts below.
					</p>
				</div>
				<div class="meta">Error<strong>404</strong></div>
			</div>

			<form class="search-form" action="/search/" method="get" role="search">
				<label class="sr-only" for="not-found-search">Search the blog</label>
				<input id="not-found-search" type="search" name="q" placeholder="Search for a topic, e.g. vSAN" />
				<button type="submit" class="button">Search</button>
			</form>

			<ol class="stack">
				<li class="stack-head" aria-hidden="true"><span></span><span>Latest posts</span></li>
				{
					recentPosts.map((post) => (
						<li class="stack-row">
							<div class="panel-label">
								<span class="big">{post.data.pubDate.getDate()}</span>
								<small>{post.data.pubDate.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' })}</small>
							</div>
							<div class="stack-body">
								<h2 class="stack-title"><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2>
							</div>
						</li>
					))
				}
			</ol>
			<p class="more"><a href="/blog/" class="button">All blog posts</a></p>
		</main>
		<Footer />
	</body>
</html>
