---
// Vector version of the site logo: the cloud with a network of people, and the
// "IvoBeerens.NL" wordmark in the site's display font. Colors come from the
// --logo-* custom properties, so the same logo works on a white or navy header.

// Network inside the cloud: one centre node and five around it
const centre = { x: 57, y: 39, r: 7 };
const nodes = [
	{ x: 57, y: 18, r: 5 },
	{ x: 37, y: 30, r: 5 },
	{ x: 77, y: 30, r: 5 },
	{ x: 42, y: 51, r: 5 },
	{ x: 72, y: 51, r: 5 },
];

// A person: head and shoulders, scaled to the node
const person = ({ x, y, r }: { x: number; y: number; r: number }) => {
	const s = r / 5;
	return {
		head: { cx: x, cy: y - 1.3 * s, r: 1.3 * s },
		shoulders: `M ${x - 2.6 * s} ${y + 2.9 * s} a ${2.6 * s} ${2.4 * s} 0 0 1 ${5.2 * s} 0`,
	};
};
---

<span class="logo">
	<svg class="logo-icon" viewBox="0 0 114 66" aria-hidden="true">
		<path
			class="cloud"
			d="M 21 62 H 97 A 18 18 0 0 0 88 27 A 32 32 0 0 0 32 25 A 19 19 0 0 0 21 62 Z"
		/>
		{nodes.map((n) => <line class="link" x1={centre.x} y1={centre.y} x2={n.x} y2={n.y} />)}
		{
			[centre, ...nodes].map((n) => {
				const p = person(n);
				return (
					<g class="node">
						<circle cx={n.x} cy={n.y} r={n.r} />
						<circle class="head" cx={p.head.cx} cy={p.head.cy} r={p.head.r} />
						<path class="shoulders" d={p.shoulders} />
					</g>
				);
			})
		}
	</svg>
	<span class="wordmark">Ivo<span class="mid">Beerens</span>.NL</span>
</span>

<style>
	.logo {
		--logo-cloud: #1f6fbf;
		--logo-net: var(--navy);
		--logo-fill: #fff;
		--logo-ink: var(--navy);
		--logo-mid: #1f6fbf;
		--logo-dot: var(--amber);
		display: inline-flex;
		align-items: flex-end;
		line-height: 1;
	}
	.logo-icon {
		flex: none;
		width: auto;
		height: 62px;
		overflow: visible;
	}
	.cloud {
		fill: var(--logo-fill);
		stroke: var(--logo-cloud);
		stroke-width: 4.5;
		stroke-linejoin: round;
	}
	.link {
		stroke: var(--logo-net);
		stroke-width: 1.6;
	}
	.node circle {
		fill: var(--logo-fill);
		stroke: var(--logo-net);
		stroke-width: 1.6;
	}
	.node .head {
		fill: none;
		stroke-width: 1.1;
	}
	.node .shoulders {
		fill: none;
		stroke: var(--logo-net);
		stroke-width: 1.1;
		stroke-linecap: round;
	}
	/* Wordmark sits on a line that runs out of the cloud and ends in a dot */
	.wordmark {
		position: relative;
		margin: 0 0 15px -3px;
		padding: 0 14px 4px 10px;
		border-bottom: 3px solid var(--logo-cloud);
		color: var(--logo-ink);
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 32px;
		letter-spacing: 0.005em;
		white-space: nowrap;
	}
	.wordmark .mid {
		color: var(--logo-mid);
		font-weight: 600;
	}
	.wordmark::after {
		content: '';
		position: absolute;
		right: -5px;
		bottom: -6.5px;
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: var(--logo-dot);
	}
	/* Phones: the cloud alone keeps room for the menu */
	@media (max-width: 720px) {
		.wordmark {
			display: none;
		}
		.logo-icon {
			height: 44px;
		}
	}
</style>
