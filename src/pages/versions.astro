---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="VMware Version Tracker" description="Track the latest versions of VMware products including ESXi, vCenter Server, and VMware Tools" />
		<style>
			.frame {
				overflow: hidden;
				border: 1px solid var(--line);
				border-radius: var(--radius);
				background: var(--page);
			}
			iframe {
				display: block;
				width: 100%;
				height: calc(100vh - 160px);
				min-height: 600px;
				border: none;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<!-- The embedded tracker has its own "VMware versions" title, so the page adds none -->
			<h1 class="sr-only">VMware versions</h1>
			<div class="frame">
				<iframe
					src="https://checkversions1.github.io/"
					title="VMware Version Tracker"
					loading="lazy"
					allow="fullscreen">
				</iframe>
			</div>
		</main>
		<Footer />
	</body>
</html> 