---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getExcerpt, getPublishedPosts } from '../lib/posts';

const posts = (await getPublishedPosts()).slice(0, 10); // Only the latest 10 posts

const day = (date: Date) => date.toLocaleDateString('en-GB', { day: 'numeric' });
const monthYear = (date: Date) => date.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' });
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			/* Exactly three lines of summary per post */
			.excerpt {
				display: -webkit-box;
				-webkit-box-orient: vertical;
				-webkit-line-clamp: 3;
				line-clamp: 3;
				overflow: hidden;
			}
			/* Centered site title and intro; the amber segment moves to the middle too */
			.page-head.centered {
				justify-content: center;
				text-align: center;
			}
			.page-head.centered .lead {
				margin: 0 auto;
			}
			.page-head.centered::after {
				left: 50%;
				transform: translateX(-50%);
			}
			.more {
				margin-top: 2rem;
				text-align: center;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="page-head centered">
				<div>
					<!-- The logo already shows the name; keep the heading for screen readers and search engines -->
					<h1 class="sr-only">IvoBeerens.NL</h1>
					<p class="lead">
						Insights and experiences about Cloud Computing, DevOps, Infrastructure as Code (IaC),
						Virtualization and End User Computing (EUC).
					</p>
				</div>
			</div>

			<ol class="stack">
				<li class="stack-head" aria-hidden="true"><span></span><span>Latest blog posts</span></li>
				{
					posts.map((post, i) => (
						<li class="stack-row">
							<div class="panel-label">
								<span class="big">{day(post.data.pubDate)}</span>
								<small>{monthYear(post.data.pubDate)}</small>
							</div>
							<div class:list={['stack-body', { 'is-new': i === 0 }]}>
								<div class="top">
									<h2 class="stack-title">
										<a href={`/blog/${post.id}/`}>{post.data.title}</a>
									</h2>
									{i === 0 && <span class="pill">NEW</span>}
								</div>
								<p class="stack-text excerpt">{getExcerpt(post)}</p>
							</div>
						</li>
					))
				}
			</ol>

			<p class="more">
				<a href="/blog/" class="button">All blog posts</a>
			</p>
		</main>
		<Footer />
	</body>
</html>
