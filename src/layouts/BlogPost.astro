---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { ETHICALADS_PUBLISHER, SUPPORT_LABEL, SUPPORT_URL } from '../consts';

type Props = CollectionEntry<'blog'>['data'] & { ogImage?: string };

const { title, description, pubDate, updatedDate, heroImage, ogImage } = Astro.props;

// Structured data so search engines can show the post as an article
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: title,
	description,
	datePublished: pubDate.toISOString(),
	dateModified: (updatedDate ?? pubDate).toISOString(),
	author: { '@type': 'Person', name: 'Ivo Beerens', url: new URL('/about/', Astro.site).href },
	image: new URL(ogImage ?? '/logo.png', Astro.site).href,
	mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
	url: pageUrl,
};
---

<html lang="en">
	<head>
		<BaseHead
			title={title}
			description={description}
			image={ogImage}
			article={{ publishedTime: pubDate, modifiedTime: updatedDate }}
		/>
		<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
		{ETHICALADS_PUBLISHER && <script is:inline async src="https://media.ethicalads.io/media/client/ethicalads.min.js" />}
		<style>
			main {
				max-width: 960px;
			}
			.page-head h1 {
				font-size: clamp(2.1rem, 5vw, 3.2rem);
			}
			.meta .updated {
				margin-top: 0.5rem;
			}
			.hero-image img {
				display: block;
				width: 100%;
				margin-bottom: 1.5rem;
				border: 1px solid var(--line);
				border-radius: var(--radius);
			}
			/* The article sits in a white card with a navy top edge */
			.prose {
				padding: 2.25rem 2.75rem 2.5rem;
				border: 1px solid var(--line);
				border-top: 6px solid var(--navy);
				border-radius: var(--radius);
				background: var(--card);
			}
			@media (max-width: 720px) {
				.prose {
					padding: 1.25rem 1.1rem 1.5rem;
				}
			}
			/* EthicalAds: one ad per page, above the article */
			.ethical-ad {
				display: flex;
				justify-content: center;
				margin: 0 0 2em;
			}
			/* "Support my work" box at the end of each post */
			.support {
				margin-top: 1.5rem;
			}
			.support .panel-label .big {
				font-size: 2rem;
			}
			.support-body {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				justify-content: space-between;
				gap: 1rem 2rem;
				padding: 1.25rem 1.75rem;
			}
			.support-body p {
				flex: 1 1 260px;
				margin: 0;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="page-head">
					<div>
						<h1>{title}</h1>
						{description && <p class="lead">{description}</p>}
					</div>
					<div class="meta">
						Published
						<strong><FormattedDate date={pubDate} /></strong>
						{
							updatedDate && (
								<div class="updated">
									Last updated
									<strong><FormattedDate date={updatedDate} /></strong>
								</div>
							)
						}
					</div>
				</div>
				{heroImage && (
					<div class="hero-image">
						<img width={1020} height={510} src={heroImage} alt="" />
					</div>
				)}
				{
					ETHICALADS_PUBLISHER && (
						<div class="ethical-ad">
							<div data-ea-publisher={ETHICALADS_PUBLISHER} data-ea-type="image" class="horizontal raised" />
						</div>
					)
				}
				<div class="prose">
					<slot />
				</div>
				{
					SUPPORT_URL && (
						<aside class="panel support" aria-label="Support my work">
							<div class="panel-label"><span class="big">Thanks</span></div>
							<div class="support-body">
								<p>
									<strong>Did this post save you time?</strong> If it helped you, you can support my
									work. Thank you!
								</p>
								<a class="button" href={SUPPORT_URL} target="_blank" rel="noopener">
									{SUPPORT_LABEL}
								</a>
							</div>
						</aside>
					)
				}
			</article>
		</main>
		<Footer />
	</body>
</html>
