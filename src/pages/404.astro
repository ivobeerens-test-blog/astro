---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { getPublishedPosts } from '../lib/posts';

const recentPosts = (await getPublishedPosts()).slice(0, 5);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Page not found - Ivo Beerens Blog" description="This page doesn't exist. Search the blog or pick one of the latest posts." />
		<meta name="robots" content="noindex" />
		<style>
			main {
				text-align: center;
			}
			.lead {
				color: rgb(var(--gray));
			}
			.search-form {
				display: flex;
				gap: 0.75rem;
				max-width: 560px;
				margin: 2rem auto 3rem;
			}
			.search-form input {
				flex: 1;
				min-width: 0;
				padding: 0.75rem 1rem;
				border: 2px solid rgba(var(--gray), 0.2);
				border-radius: 8px;
				font: inherit;
			}
			.search-form input:focus {
				outline: none;
				border-color: var(--accent-dark);
			}
			.search-form button {
				padding: 0.75rem 1.5rem;
				border: none;
				border-radius: 8px;
				background: var(--accent-dark);
				color: #fff;
				font: inherit;
				font-weight: 600;
				cursor: pointer;
			}
			.recent {
				max-width: 720px;
				margin: 0 auto;
				padding: 0;
				list-style: none;
			}
			.recent li {
				padding: 1rem 0;
				border-bottom: 1px solid rgba(var(--gray), 0.2);
			}
			.recent a {
				font-weight: 700;
				text-decoration: none;
			}
			.recent .date {
				display: block;
				color: rgb(var(--gray));
				font-size: 0.9em;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>Page not found</h1>
			<p class="lead">
				This page doesn't exist (any more). Try searching the blog, or start with one of the
				latest posts below.
			</p>

			<form class="search-form" action="/search/" method="get" role="search">
				<label class="sr-only" for="not-found-search">Search the blog</label>
				<input id="not-found-search" type="search" name="q" placeholder="Search for a topic, e.g. vSAN" />
				<button type="submit">Search</button>
			</form>

			<h2>Latest posts</h2>
			<ul class="recent">
				{
					recentPosts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`}>{post.data.title}</a>
							<span class="date">
								<FormattedDate date={post.data.pubDate} />
							</span>
						</li>
					))
				}
			</ul>
			<p><a href="/blog/">See all blog posts →</a></p>
		</main>
		<Footer />
	</body>
</html>
