---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// Markdown pages that use this layout (about.md) pass their frontmatter as `frontmatter`
type Props = { frontmatter: CollectionEntry<'blog'>['data'] };

const { title, description, heroImage } = Astro.props.frontmatter;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				max-width: 960px;
			}
			.hero-image img {
				display: block;
				width: 100%;
				margin-bottom: 1.5rem;
				border: 1px solid var(--line);
				border-radius: var(--radius);
			}
			.prose {
				padding: 2.25rem 2.75rem 2.5rem;
				border: 1px solid var(--line);
				border-top: 6px solid var(--navy);
				border-radius: var(--radius);
				background: var(--card);
			}
			@media (max-width: 720px) {
				.prose {
					padding: 1.25rem 1.1rem 1.5rem;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="page-head">
					<div>
						<h1>{title}</h1>
					</div>
				</div>
				{heroImage && (
					<div class="hero-image">
						<img width={1020} height={510} src={heroImage} alt="" />
					</div>
				)}
				<div class="prose">
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html> 