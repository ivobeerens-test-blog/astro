---
import { Image } from 'astro:assets';
import HeaderLink from './HeaderLink.astro';
import Logo from './Logo.astro';
import { HEADER_STYLE } from '../consts';
// Header copy of the logo with the empty border cropped off; public/logo.png stays the social sharing image
import logo from '../assets/logo-trimmed.png';
---

<header class:list={[`header-${HEADER_STYLE}`]}>
	<nav>
		<div class="logo-container">
			<a href="/" aria-label="IvoBeerens.NL home">
				{
					HEADER_STYLE === 'image' ? (
						<Image src={logo} alt="" height={56} densities={[1, 2]} loading="eager" class="logo" />
					) : (
						<Logo />
					)
				}
			</a>
		</div>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
			<HeaderLink href="/links">Links</HeaderLink>
			<HeaderLink href="/versions">VMware Versions</HeaderLink>
			<HeaderLink href="/search" aria-label="Search" class="search-link">
				<!-- Magnifying glass icon -->
				<svg class="search-icon" viewBox="0 0 24 24" aria-hidden="true" width="20" height="20">
					<path fill="currentColor" d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
				</svg>
				<span class="search-text">Search</span>
			</HeaderLink>
		</div>
		<div class="social-links">
			<a href="https://www.linkedin.com/in/ivobeerens/" target="_blank">
				<span class="sr-only">Follow ibeerens on LinkedIn</span>
				<svg viewBox="0 0 24 24" aria-hidden="true" width="32" height="32">
					<path fill="currentColor" d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
				</svg>
			</a>
			<a href="https://github.com/ibeerens" target="_blank">
				<span class="sr-only">Follow ibeerens on GitHub</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32">
					<path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
				</svg>
			</a>
			<a href="https://bsky.app/profile/ibeerens.bsky.social" target="_blank">
				<span class="sr-only">Follow ibeerens on Bluesky</span>
				<svg viewBox="0 0 600 530" aria-hidden="true" width="32" height="32">
					<path fill="currentColor" d="m135.72 44.03c66.496 49.921 138.02 151.14 164.28 205.46 26.262-54.316 97.782-155.54 164.28-205.46 47.98-36.021 125.72-63.892 125.72 24.795 0 17.712-10.155 148.79-16.111 170.07-20.703 73.984-96.144 92.854-163.25 81.433 117.3 19.964 147.14 86.092 82.697 152.22-122.39 125.59-175.91-31.511-189.63-71.766-2.514-7.3797-3.6904-10.832-3.7077-7.8964-0.0174-2.9357-1.1937 0.51669-3.7077 7.8964-13.714 40.255-67.233 197.36-189.63 71.766-64.444-66.128-34.605-132.26 82.697-152.22-67.108 11.421-142.55-7.4491-163.25-81.433-5.9562-21.282-16.111-152.36-16.111-170.07 0-88.687 77.742-60.816 125.72-24.795z"/>
				</svg>
			</a>
			<a href="https://x.com/ibeerens" target="_blank">
				<span class="sr-only">Follow ibeerens on X</span>
				<svg viewBox="0 0 24 24" aria-hidden="true" width="32" height="32">
					<path fill="currentColor" d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"/>
				</svg>
			</a>
			<a href="/rss.xml" target="_blank">
				<span class="sr-only">RSS Feed</span>
				<svg viewBox="0 0 24 24" aria-hidden="true" width="32" height="32">
					<path fill="currentColor" d="M6.503 20.752c0 1.794-1.456 3.248-3.251 3.248-1.796 0-3.252-1.454-3.252-3.248 0-1.794 1.456-3.248 3.252-3.248 1.795.001 3.251 1.454 3.251 3.248zm-6.503-12.572v4.811c6.05.062 10.96 4.966 11.022 11.009h4.817c-.062-8.71-7.118-15.758-15.839-15.82zm0-3.368c10.58.046 19.152 8.594 19.183 19.188h4.817c-.03-13.231-10.755-23.954-24-24v4.812z"/>
				</svg>
			</a>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1.25em;
		background: #fff;
		border-bottom: 1px solid var(--line);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		max-width: calc(var(--wrap) - 2.5em);
		margin: 0 auto;
		padding: 0.4em 0;
	}
	.logo-container {
		display: flex;
		align-items: center;
	}
	.logo-container a {
		display: flex;
	}
	.logo {
		display: block;
		height: 56px;
		width: auto;
		border-radius: 0;
	}
	nav {
		min-height: 88px;
	}
	/* Navy header: white logo, white menu, amber marks */
	.header-navy {
		background: var(--navy);
		border-bottom: none;
	}
	.header-navy :global(.logo) {
		--logo-fill: var(--navy);
		--logo-cloud: #fff;
		--logo-net: #fff;
		--logo-ink: #fff;
		--logo-mid: #9cc6f0;
	}
	.header-navy .internal-links :global(a),
	.header-navy .social-links a {
		color: #fff;
	}
	.header-navy .internal-links :global(a:hover),
	.header-navy .social-links a:hover,
	.header-navy .social-links a:focus-visible {
		color: var(--amber);
	}
	/* Menu: condensed caps, amber bar under the current section */
	.internal-links {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 0.25rem;
	}
	.internal-links :global(a) {
		position: relative;
		padding: 0.6em 0.7em;
		color: var(--ink);
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 1.1em;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}
	.internal-links :global(a::after) {
		content: '';
		position: absolute;
		left: 0.7em;
		right: 0.7em;
		bottom: 0.25em;
		height: 3px;
		background: transparent;
		transition: background-color 0.15s ease;
	}
	.internal-links :global(a:hover) {
		color: var(--link);
	}
	.internal-links :global(a.active::after) {
		background: var(--amber);
	}
	.internal-links .search-link {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
	}
	.internal-links .search-link:focus-visible {
		outline: 2px solid var(--link);
		outline-offset: 2px;
	}
	.internal-links .search-link .search-text {
		display: none;
	}
	.internal-links .search-link .search-icon {
		width: 1.2em;
		height: 1.2em;
	}
	.social-links,
	.social-links a {
		display: flex;
	}
	.social-links {
		gap: 0.6rem;
	}
	.social-links a {
		color: var(--navy);
		transition: color 0.15s ease;
	}
	.social-links a:hover,
	.social-links a:focus-visible {
		color: var(--amber);
	}
	.social-links svg {
		width: 22px;
		height: 22px;
	}
	/* Keep the menu on one line: drop the social icons first, then put the logo above the menu */
	@media (min-width: 961px) {
		.internal-links {
			flex-wrap: nowrap;
		}
	}
	@media (max-width: 1180px) {
		.social-links {
			display: none;
		}
	}
	@media (max-width: 960px) {
		nav {
			flex-direction: column;
			gap: 0;
			min-height: 0;
			padding-top: 0.6em;
		}
	}
	@media (max-width: 720px) {
		.logo {
			height: 40px;
		}
		.internal-links :global(a) {
			padding: 0.5em 0.45em;
			font-size: 1em;
		}
		.internal-links :global(a::after) {
			left: 0.45em;
			right: 0.45em;
		}
		.internal-links .search-link .search-text {
			display: inline-block;
		}
		.internal-links .search-link .search-icon {
			display: none;
		}
	}
</style>
